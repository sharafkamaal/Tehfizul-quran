# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.org

# Contact / admission form delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Inbox that receives form submissions
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Madrasa Website <noreply@yourdomain.org>"
CONTACT_FROM_EMAIL=
